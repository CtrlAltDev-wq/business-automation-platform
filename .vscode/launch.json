{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI (Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "jinja": true,
            "justMyCode": false,
            "subProcess": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Integration worker (once)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.workers.integration_worker",
            "args": ["--once"],
            "justMyCode": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Integration worker (loop)",
            "type": "debugpy",
            "request": "launch",
            "module": "app.workers.integration_worker",
            "args": ["--interval", "15"],
            "justMyCode": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}