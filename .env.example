# Copy this file to .env and fill in your own values.

# Shared secret required by POST /api/v1/webhooks/leads (X-Webhook-Secret header).
WEBHOOK_SECRET=replace-with-your-own-secret

# SQLAlchemy database URL. Prefer PostgreSQL; SQLite is used by default.
# DATABASE_URL=postgresql+psycopg://app_user:your-password@127.0.0.1:5432/business_automation
# DATABASE_URL=sqlite:///./business.db

# Set to true to log every SQL statement.
# SQL_ECHO=false

# ---------------------------------------------------------------------------
# Integrations (Google Sheets / email auto-reply / n8n)
# ---------------------------------------------------------------------------
# Master switch for the outbound automation queue.
# INTEGRATIONS_ENABLED=true
# Retry policy: maximum delivery attempts and the base delay in seconds
# (backoff is 30s, 60s, 120s, ...).
# INTEGRATION_MAX_ATTEMPTS=5
# INTEGRATION_RETRY_BASE_SECONDS=30

# n8n: paste the production/test URL of a Webhook node that accepts
# {"event": "lead.created", "data": {...}}. Leave empty to run in dry-run mode.
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lead-created

# Google Sheets: path to a service-account JSON key and the target spreadsheet id
# (the long id in https://docs.google.com/spreadsheets/d/<ID>/edit).
# Share the spreadsheet with the service-account email as Editor.
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# GOOGLE_SHEETS_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# GOOGLE_SHEETS_RANGE=Leads!A:H

# SMTP: when SMTP_HOST is empty the auto-reply is only written to the log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=mailer@example.com
# SMTP_USE_TLS=true
# AUTO_REPLY_SUBJECT=Thanks for contacting us
# AUTO_REPLY_BODY=Hi {name},\n\nthanks for reaching out.\n\nBest regards,\nThe team
